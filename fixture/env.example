# news: deployment values. Settings an Administrator tunes live in the database.

# --- Infrastructure

# The Postgres the app and tunables share.
DATABASE_URL=

# --- Mechanics

# Advisory lock id the scheduler holds while it ticks.
# NEWS_LOCK_SCHEDULER=7101

# Rows written per statement when a batch is saved.
# NEWS_QUERY_BATCH=500

# How much of an error message is kept on a failed item.
# NEWS_KEPT_ERROR_CHARACTERS=2000

# How much the server and worker log.
# One of: debug, info, warn, error.
# NEWS_LOG_LEVEL=info

{
  "name": "@tunables/playground",
  "private": true,
  "type": "module",
  "description": "The news fixture as a Nuxt app: tunables' screens over oRPC, with Postgres or memory storage. Used to see the screens and to photograph them.",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "screenshots": "playwright test",
    "screenshots:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@nuxt/ui": "^4.12.0",
    "@orpc/client": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "nuxt": "~4.4.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.0",
    "tunables": "link:..",
    "vue": "^3.5.44",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.1.0"
  }
}
